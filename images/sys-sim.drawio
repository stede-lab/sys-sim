        <mxCell id="hNk4KgPiiBQnAUEUszCB-38" value="&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;part def MyPart {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; exhibit state MyState {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; state initial;&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; action MyAction {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; in arg: String&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontFamily=Courier New;fontSize=7;" vertex="1" parent="1">
